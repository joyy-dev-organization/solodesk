{
  "name": "solodesk-service",
  "version": "0.1.0",
  "description": "Local loopback Mastra service for SoloDesk",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/health.test.ts test/error-envelope.test.ts",
    "test:integration": "vitest run --fileParallelism=false",
    "eval": "vitest run test/m1-model-spike.test.ts",
    "eval:12cases": "tsx src/eval/run-12case-eval.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "solodesk",
    "mastra",
    "ollama",
    "local-ai"
  ],
  "author": "ladydiamond",
  "license": "MIT",
  "dependencies": {
    "@mastra/core": "^1.78.0",
    "ollama-ai-provider-v2": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
